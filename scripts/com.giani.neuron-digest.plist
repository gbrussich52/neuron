    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/gianibrussich/knowledge-base/logs/neuron-digest.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/gianibrussich/knowledge-base/logs/neuron-digest.err.log</string>
