    <false/>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/gianibrussich/.bun/bin:/Users/gianibrussich/.local/bin:/Users/gianibrussich/.nvm/versions/node/v24.6.0/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/gianibrussich</string>
        <key>KB_DIR</key>
        <string>/Users/gianibrussich/knowledge-base</string>
    </dict>
</dict>
