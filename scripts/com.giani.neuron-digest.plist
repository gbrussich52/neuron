<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.giani.neuron-digest</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/gianibrussich/.nvm/versions/node/v24.6.0/bin/node</string>
        <string>/Users/gianibrussich/project-claude/llm-knowledge-base/brain-cli/brain.js</string>
        <string>digest</string>
    </array>
    <!-- Sunday 07:00, after Saturday night's 03:07 improve loop and the 06:00
         rollup, so the week's last compile is already in the wiki when the
         digest reads it. Weekday 0 = Sunday. -->
