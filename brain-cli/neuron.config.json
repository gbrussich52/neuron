{
  "provider": "claude-cli",

  "providers": {
    "claude-cli": {
      "description": "Shell out to claude --print (default, zero config needed)"
    },
    "anthropic-api": {
      "base_url": "https://api.anthropic.com",
      "api_key_env": "ANTHROPIC_API_KEY",
      "api_version": "2023-06-01"
    },
    "openai-compatible": {
      "base_url": "http://localhost:11434/v1",
      "api_key_env": "OPENAI_API_KEY",
      "description": "Works with Ollama, Grok API, LM Studio, any OpenAI-compatible endpoint"
    }
  },

  "models": {
    "claude-cli":        { "opus": "opus", "sonnet": "sonnet", "haiku": "haiku" },
    "anthropic-api":     { "opus": "claude-opus-4-7", "sonnet": "claude-sonnet-4-6", "haiku": "claude-haiku-4-5-20251001" },
    "openai-compatible": { "opus": "gemma4:e4b", "sonnet": "gemma4:e4b", "haiku": "gemma4:e2b" }
  },

  "tiers": {
    "classify":   "haiku",
    "compile":    "sonnet",
    "synthesize": "opus"
  },

  "embed": {
    "provider": "openai-compatible",
    "base_url": "http://localhost:11434/v1",
    "model": "nomic-embed-text",
    "dimensions": 768
  },

  "features": {
    "semantic_search": true,
    "connection_finder": true,
    "auto_research": false,
    "metrics": false,
    "auto_improve": false,
    "auto_commit": false
  },

  "research": {
    "tavily_api_key_env": "TAVILY_API_KEY",
    "max_steps": 5,
    "auto_compile": true,
    "auto_connect": true,
    "include_domains": [],
    "exclude_domains": [],
    "preferred_sources": [
      "github.com",
      "gist.github.com",
      "stackoverflow.com",
      "news.ycombinator.com",
      "reddit.com",
      "medium.com",
      "dev.to",
      "substack.com",
      "linkedin.com"
    ]
  },

  "improve": {
    "max_iterations": 5,
    "target_grade": "B",
    "research_gaps_per_iteration": 2
  },

  "timeouts": {
    "yt_dlp_title_ms": 15000,
    "yt_dlp_sub_ms": 30000
  },

  "paths": {
    "tmp_dir": "/tmp"
  }
}
